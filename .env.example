# ANTHROPIC_API_KEY: Optional. Enables Claude features (description understanding,
# estimate review, live price checks). Server-side only — never sent to the browser.
# Get a key at https://platform.claude.com/ . Without it the app still works (keyword matching, no review).
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRUST_PROXY: Optional. Number of proxy hops in front of the server (e.g. 1 on Render/Fly.io/Cloud Run)
# so rate limits apply per visitor. Leave unset when running directly.
TRUST_PROXY=""
